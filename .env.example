# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env to version control!

# LLM Provider Configuration ('gemini', 'ollama', or 'groq')
LLM_PROVIDER=gemini

# ==============================================================================
# Google Gemini Configuration (required if LLM_PROVIDER=gemini)
# ==============================================================================
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Model options: gemini-2.5-flash, gemini-2.0-flash
# LLM_MODEL_NAME=gemini-2.5-flash

# ==============================================================================
# GroqCloud Configuration (required if LLM_PROVIDER=groq)
# ==============================================================================
GROQ_API_KEY=your_groqcloud_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Free-tier model options: openai/gpt-oss-20b (fast, recommended default), openai/gpt-oss-120b (higher reasoning), allam-2-7b (Arabic)
GROQ_MODEL_NAME=openai/gpt-oss-20b

# ==============================================================================
# Free-Tier Rate Limiting & Optimization
# ==============================================================================
# Client-side minimum interval between LLM calls in seconds (avoids RPM/TPM bursts)
LLM_MIN_INTERVAL_SECONDS=1.0
# Independent second LLM verification call for MCQs (false saves 1 LLM call per MCQ)
VERIFY_MCQ_ANSWERS=false
# Maximum generation retry attempts per question on validation error
MAX_PER_QUESTION_RETRIES=3
# Optional comma-separated fallback chain on 429/5xx (e.g. 'gemini,ollama')
# LLM_FALLBACK_PROVIDERS=gemini


# ==============================================================================
# Ollama Local Configuration (required if LLM_PROVIDER=ollama)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_NUM_CTX=4096

# ==============================================================================
# Embeddings & Vector Database
# ==============================================================================
# Local retrieval embeddings must use a Hugging Face sentence-transformers model.
HF_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=data/processed/chroma_db

# ==============================================================================
# Project Environment & Security
# ==============================================================================
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite:///./assessment.db

# ==============================================================================
# LangSmith Observability & Tracing (optional, for RAG evaluation & tracing)
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=educational-assessment
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

