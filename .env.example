# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env to version control!

# Google Gemini API
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash-lite

# Local retrieval embeddings must use a Hugging Face sentence-transformers model.
HF_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector Database (e.g., Chroma, Qdrant, Pinecone)
VECTOR_DB_PATH=data/processed/curriculum_rag_store

# Project Environment
ENVIRONMENT=development

# Web Application
JWT_SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite:///./assessment.db
